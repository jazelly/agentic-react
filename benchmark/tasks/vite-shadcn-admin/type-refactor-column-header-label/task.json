{
  "id": "vite-shadcn-admin/type-refactor-column-header-label",
  "repo": "vite-shadcn-admin",
  "category": "build-type-error",
  "prompt": "We're renaming the `title` prop of `DataTableColumnHeader` to `label`. The component itself is already migrated, but `pnpm build` now fails with TypeScript errors. Finish the refactor across the codebase: call sites must pass `label`. Don't add `title` back to the component and don't use @ts-ignore / any.",
  "setup": {
    "edits": [
      {
        "file": "src/components/data-table/column-header.tsx",
        "regex": true,
        "all": true,
        "find": "\\btitle\\b",
        "replace": "label"
      }
    ]
  },
  "solution": [
    {
      "file": "src/features/tasks/components/tasks-columns.tsx",
      "regex": true,
      "all": true,
      "find": "(DataTableColumnHeader column=\\{column\\}) title=",
      "replace": "$1 label="
    },
    {
      "file": "src/features/users/components/users-columns.tsx",
      "regex": true,
      "all": true,
      "find": "(DataTableColumnHeader column=\\{column\\}) title=",
      "replace": "$1 label="
    }
  ],
  "check": {
    "steps": [
      {
        "type": "regex",
        "files": [
          "src/**/*.tsx"
        ],
        "pattern": "<DataTableColumnHeader[^>]*\\btitle=",
        "expect": false
      },
      {
        "type": "regex",
        "file": "src/components/data-table/column-header.tsx",
        "pattern": "\\btitle\\b",
        "expect": false
      },
      {
        "type": "forbid",
        "pattern": "@ts-ignore|@ts-expect-error|\\bas any\\b|eslint-disable",
        "why": "no type-system escape hatches in the agent diff"
      },
      {
        "type": "cmd",
        "run": "@typecheck",
        "timeoutSec": 600,
        "why": "repo typecheck (vite-shadcn-admin)"
      }
    ]
  },
  "budget": {
    "timeoutMin": 30,
    "maxTurns": 60
  }
}
