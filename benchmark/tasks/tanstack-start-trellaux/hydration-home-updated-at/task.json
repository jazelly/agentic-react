{
  "id": "tanstack-start-trellaux/hydration-home-updated-at",
  "repo": "tanstack-start-trellaux",
  "category": "hydration",
  "prompt": "The Boards home page logs a React hydration mismatch (`Text content does not match server-rendered HTML`) coming from the small \"updated …\" time next to the heading. Keep showing the time, but fix the hydration error.",
  "setup": {
    "edits": [
      {
        "file": "src/routes/index.tsx",
        "find": "      <h1 className=\"text-2xl font-black\">Boards</h1>",
        "replace": "      <h1 className=\"text-2xl font-black\">\n        Boards{' '}\n        <span className=\"text-xs text-slate-400\">\n          updated {new Date().toLocaleTimeString()}\n        </span>\n      </h1>"
      }
    ]
  },
  "solution": [
    {
      "file": "src/routes/index.tsx",
      "find": "          updated {new Date().toLocaleTimeString()}",
      "replace": "          updated <span suppressHydrationWarning>{new Date().toLocaleTimeString()}</span>"
    }
  ],
  "check": {
    "steps": [
      {
        "type": "regex",
        "file": "src/routes/index.tsx",
        "pattern": "updated",
        "expect": true
      },
      {
        "type": "regex",
        "file": "src/routes/index.tsx",
        "pattern": "useEffect|useHydrated|ClientOnly|suppressHydrationWarning|useSyncExternalStore",
        "expect": true
      },
      {
        "type": "browser",
        "optional": true,
        "start": "@dev",
        "url": "/",
        "failOnConsole": "hydrat"
      }
    ]
  },
  "budget": {
    "timeoutMin": 30,
    "maxTurns": 60
  }
}
