{
  "id": "next-turbopack-boilerplate/validation-counter-range",
  "repo": "next-turbopack-boilerplate",
  "category": "state-bug",
  "prompt": "On /counter the form says you can increment by 1 to 3, but entering 2 or 3 shows the range error (and the API rejects it too). Fix it; 0 and 4 must still be rejected.",
  "setup": {
    "edits": [
      {
        "file": "src/validations/CounterValidation.ts",
        "find": "  increment: z.number().min(1).max(3),",
        "replace": "  increment: z.number().min(1).max(1),"
      }
    ]
  },
  "solution": "reverse-setup",
  "check": {
    "steps": [
      {
        "type": "cmd",
        "run": "node --input-type=module -e \"const {CounterValidation:v}=await import('./src/validations/CounterValidation.ts');const ok=n=>v.safeParse({increment:n}).success;if(!(ok(1)&&ok(2)&&ok(3)&&!ok(0)&&!ok(4)))process.exit(1)\"",
        "timeoutSec": 60
      }
    ]
  },
  "budget": {
    "timeoutMin": 30,
    "maxTurns": 60
  }
}
