{
  "appDir": ".",
  "commands": {
    "install": "pnpm install --ignore-workspace --frozen-lockfile",
    "dev": "pnpm --ignore-workspace dev",
    "devNote": "Full UI needs the Go backend (make dev). Tasks are designed to be verifiable with vitest + tsc only.",
    "build": "pnpm --ignore-workspace build",
    "typecheck": "pnpm --ignore-workspace typecheck",
    "test": "pnpm --ignore-workspace exec vitest run"
  },
  "check": {
    "steps": [
      {
        "type": "hidden-test",
        "src": "hidden/AddButton.default-label.test.tsx",
        "dest": "app/react/components/buttons/__bench__/AddButton.default-label.test.tsx",
        "run": "pnpm --ignore-workspace exec vitest run app/react/components/buttons",
        "timeoutSec": 600
      },
      {
        "type": "only-changed",
        "allow": [
          "app/react/components/buttons/AddButton.tsx"
        ]
      }
    ]
  },
  "hiddenBase": "/tests/hidden"
}
