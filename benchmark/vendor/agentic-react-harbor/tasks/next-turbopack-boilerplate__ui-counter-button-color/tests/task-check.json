{
  "appDir": ".",
  "commands": {
    "install": "npm ci",
    "dev": "npm run dev",
    "devUrl": "http://localhost:3000",
    "build": "npm run build-local",
    "typecheck": "npm run check:types",
    "test": "npm test",
    "e2e": "npm run test:e2e"
  },
  "check": {
    "steps": [
      {
        "type": "regex",
        "file": "src/components/CounterForm.tsx",
        "pattern": "bg-emerald-600",
        "expect": true
      },
      {
        "type": "regex",
        "file": "src/components/CounterForm.tsx",
        "pattern": "hover:bg-emerald-700",
        "expect": true
      },
      {
        "type": "regex",
        "file": "src/components/CounterForm.tsx",
        "pattern": "bg-blue-500|hover:bg-blue-600",
        "expect": false
      },
      {
        "type": "regex",
        "file": "src/components/CounterForm.tsx",
        "pattern": "focus:ring-3.*disabled:opacity-50",
        "expect": true
      },
      {
        "type": "only-changed",
        "allow": [
          "src/components/CounterForm.tsx"
        ]
      }
    ]
  }
}
