# Generated by scripts/convert-to-harbor.mjs — repo base for next-webpack-jsoncrack.
# Node node:24-bookworm (engines.node >=24).
# Task Dockerfiles FROM this image; rebuild when SHA / lockfile / this Dockerfile change.
FROM node:24-bookworm

RUN apt-get update -qq \
 && apt-get install -y -qq git ca-certificates python3 \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable

WORKDIR /app

ARG REPO_URL="https://github.com/AykutSarac/jsoncrack.com"
ARG BASE_SHA="a46d0d0adb098e12e577a083e87ead7f61f90098"
ENV BENCH_APP_DIR="apps/www"
ENV BENCH_REPO_ID="next-webpack-jsoncrack"

# Pin to BASE_SHA on a real branch with no future history / remotes.
# Full clone (not --filter=blob:none): partial clones break under git gc --prune.
RUN git clone "$REPO_URL" . \
 && DEFAULT="$(git remote show origin | sed -n 's/.*HEAD branch: //p')" \
 && DEFAULT="${DEFAULT:-main}" \
 && git checkout -B "$DEFAULT" "$BASE_SHA" \
 && git remote remove origin \
 && for b in $(git for-each-ref --format='%(refname:short)' refs/heads | grep -vx "$DEFAULT"); do git branch -D "$b" || true; done \
 && for t in $(git tag); do git merge-base --is-ancestor "$t" HEAD 2>/dev/null || git tag -d "$t"; done \
 && git reflog expire --expire=now --all \
 && (git gc --prune=now || true) \
 && (git submodule update --init --recursive || true)


# Package manager install (from manifest.json). pnpm
WORKDIR /app
RUN pnpm config set dangerouslyAllowAllBuilds true && pnpm install --frozen-lockfile
WORKDIR /app

COPY prefetch-google-fonts.mjs /opt/bench/prefetch-google-fonts.mjs
RUN node /opt/bench/prefetch-google-fonts.mjs --out /opt/bench --app "/app/apps/www"
ENV NEXT_FONT_GOOGLE_MOCKED_RESPONSES=/opt/bench/mocked-google-fonts.cjs

# Clean tree ready for per-task setup edits (applied in the thin task image).
CMD ["/bin/bash"]
